<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lucid" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/app_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="colorPrimary">@color/clay_500</item>
        <item name="colorAccent">@color/clay_500</item>
        <item name="android:textColorPrimary">@color/ink_900</item>
        <item name="android:fontFamily">@font/lucid_sans</item>
    </style>
</resources>
