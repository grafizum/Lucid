<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_dark_bg"
    android:elevation="18dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/statusDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/lucid_sans"
            android:letterSpacing="0.22"
            android:text="READY"
            android:textColor="@color/sand_300"
            android:textSize="9sp" />

        <com.grafizum.lucid.LoadingRing
            android:id="@+id/statusSpinner"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="9dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/closeBtn"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/sand_500"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/langRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/srcChip"
            android:layout_width="wrap_content"
            android:maxWidth="150dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_height="22dp"
            android:background="@drawable/chip_dark_bg"
            android:fontFamily="@font/lucid_sans"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="Detected"
            android:textColor="@color/sand_400"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:text="→"
            android:textColor="@color/stone_500"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/dstChip"
            android:layout_width="wrap_content"
            android:maxWidth="132dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_height="22dp"
            android:background="@drawable/chip_accent_dark_bg"
            android:fontFamily="@font/lucid_sans"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="English"
            android:textColor="@color/clay_300"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/bodyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/lucid_sans"
        android:lineSpacingMultiplier="1.34"
        android:maxLines="12"
        android:ellipsize="end"
        android:textColor="@color/cream_50"
        android:textSize="16sp" />

    <!-- Its own class, because the kana above the kanji need real room to sit
         in: the view keeps a top padding for them and draws them there. -->
    <com.grafizum.lucid.RubyTextView
        android:id="@+id/originalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/lucid_sans"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/sand_500"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Word by word: one row per word, the word in clay and its meaning
         beside it, filled in after the translation lands. -->
    <LinearLayout
        android:id="@+id/wordsBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/footRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/metaText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/lucid_sans"
            android:letterSpacing="0.06"
            android:textColor="@color/stone_500"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/copyBtn"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/btn_dark_ghost"
            android:fontFamily="@font/lucid_sans"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Copy"
            android:textColor="@color/sand_300"
            android:textSize="10.5sp" />
    </LinearLayout>
</LinearLayout>
