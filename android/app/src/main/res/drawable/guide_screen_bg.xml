<?xml version="1.0" encoding="utf-8"?>
<!-- A drawing of the screen Android is about to show — not a screenshot, so
     it can never be out of date or wrong for the phone in hand. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1E1D19" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="#2E2C27" />
</shape>
