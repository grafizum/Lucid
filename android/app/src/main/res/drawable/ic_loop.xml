<?xml version="1.0" encoding="utf-8"?>
<!-- The lens, in silhouette: the same one ring and handle as the launcher art
     and the header, drawn thin enough for a system icon. It is the ongoing
     notification's small icon and the service's own icon, where the mark has
     to read at status-bar size; the shade's button uses ic_tile_mark, the
     glyphs without the lens. Both are tinted by the system, so neither draws its
     own colour. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:pathData="M10.1,10.1 m-6.2,0 a6.2,6.2 0 1,0 12.4,0 a6.2,6.2 0 1,0 -12.4,0"
        android:strokeColor="@color/cream_50"
        android:strokeWidth="1.9" />

    <path
        android:pathData="M14.48,14.48 L19.08,19.08"
        android:strokeColor="@color/cream_50"
        android:strokeWidth="2.1"
        android:strokeLineCap="round" />
</vector>
