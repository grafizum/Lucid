<?xml version="1.0" encoding="utf-8"?>
<!-- One state, on purpose: a press is answered by motion (Press.kt), so the
     chip keeps its own shape, fill and hairline while it sinks. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/cream_200" />
    <corners android:radius="999dp" />
    <stroke android:width="1dp" android:color="@color/hairline_light" />
</shape>
